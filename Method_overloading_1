class area_of_shapes{
	void area(int side){
		System.out.println("The area of square is "+side*side);
	}
	void area(float length,float breath){
		System.out.println("The area of rectangle is "+length*breath);
	}
	void area(float radius){
		float pi=3.14f;
		System.out.println("The are of circle is "+pi*radius);
	}
}

class method_overloading1{
	public static void main(String[] args){
		area_of_shapes h1=new area_of_shapes();
		h1.area(8);
		h1.area(6.5f,3.0f);
		h1.area(8.0f);
	}
}
